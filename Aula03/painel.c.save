#include <stdio.h>
#include <strings.h>

int main()
{
	char estado_motor[2];
	int rpm;
	int temperatura;
	int velocidade;
	int nivel_bateria;
	int nivel_combustivel;
	char estado_farol[2];
	char status_ecu[20];

	printf("O Motor está ligado?\n"
		"(S ou N): ");
	scanf("%1s", estado_motor);

        printf("Digite o RPM: ");
        scanf("%d", &rpm);

        printf("Digite a Temperatura: ");
        scanf("%d", &temperatura);

        printf("Digite a Velocidade atual: ");
        scanf("%d", &velocidade);

	printf("Digite o nível de Tensão atual da Bateria: ");
	scanf("%d", &nivel_bateria);

	printf("Digite o nível atual de Combustível: ");
	scanf("%d", &nivel_combustivel);

	printf("O farol está aceso?\n"
		"(S ou N): ");
	scanf("%1s", estado_farol);

        printf("\n================ ECU ==============\n");

	if (strcmp(estado_motor, "s") == 0 || strcmp(estado_motor, "S") == 0)
	{
		printf("..... MOTOR EM FUNCIONAMENTO .....\n\n");
	}
	else if (strcmp(estado_motor, "n") == 0 || strcmp(estado_motor, "N") == 0)
	{
		printf("........ MOTOR DESLIGADO .........\n\n");
	}
	else
	{
		printf("... ESTADO DO MOTOR DESCONHECIDO ...\n\n");
		status_ecu == "CRITICO";
	}

	printf("RPM...................... %i\n\n", rpm);
	if (rpm >= 6000) && (status_ecu != "CRITICO")
	{
		status_ecu == "ALERTA";
	}

	printf("Temperatura.............. %i °C\n", temperatura);
        if (temperatura >= 110)
        {
		status_ecu == "CRITICO";
//                printf("........... ALERTA!! .........."...... SUPERAQUECIMENTO!! ......\n\n");
        }
        else if (temperatura >= 95) && (status_ecu != "CRITICO")
	{
		status_ecu == "ALERTA"
//		printf("..... Temperatura elevada! .....\n"
		printf("Ventoinha.................... LIGADA\n\n");
	}
	else if (temperatura < 95)
	{
		printf("..... Temperatura Normal .....\n"
                        "....... Ventoinha DESLIGADA .......\n\n");
        }

	printf("Velocidade............... %i Km/h\n\n", velocidade);

	printf("Tensão da Bateria........ %i V\n", nivel_bateria);
	if (nivel_bateria < 12)
        {
                printf("........... ALERTA!! ...........\n"
                	"... Tensão da Bateria baixa! ...\n\n");
        }
	else
        {
		printf("..... Sistema Elétrico OK .....\n\n");
        }


	printf("Nível de Combustível..... %i %%\n", nivel_combustivel);
        if (nivel_combustivel <= 15)
        {
                printf("........... ALERTA!! ...........\n"
                	".... Combustível na reserva ....\n\n");
        }
        else
        {
                printf("... Nível de combustível OK ...\n\n");
        }


	if (strcmp(estado_farol, "s") == 0 || strcmp(estado_farol, "S") == 0)
	{
		printf("Farol.................... LIGADO\n\n");
	}
	else if (strcmp(estado_farol, "n") == 0 || strcmp(estado_farol, "N") == 0)
        {
		printf("Farol................. DESLIGADO\n\n");
	}
	else
	{
		printf("........... ALERTA!! ..........."
			"... ESTADO DO FAROL DESCONHECIDO ...\n\n");
        }

	printf("Status da ECU ................. %s\n", status_ecu);
        printf("===================================\n\n");

	return 0;
}

